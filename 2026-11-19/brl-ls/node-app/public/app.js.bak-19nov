/* BRL Loading Supervisor – front end (vanilla JS, no build step) */
let S = JSON.parse(localStorage.getItem('ls_session') || 'null'); let CFG = { hrMobile: '', requireSelfie: false, branches: [] }; let photoData = ''; let GEO = null;
const app = document.getElementById('app'); const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
setInterval(() => $('clock').textContent = new Date().toLocaleString('en-IN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' }), 1000);
async function api(path, body, method) { const h = { 'Content-Type': 'application/json' }; if (S) { h['x-code'] = S.code; h['x-token'] = S.token; } const r = await fetch('/api' + path, { method: method || (body ? 'POST' : 'GET'), headers: h, body: body ? JSON.stringify(body) : undefined }); const j = await r.json().catch(() => ({ error: 'Server error ' + r.status })); if (r.status === 401 && S && path !== '/login') { logout('Session expired – sign in again.'); throw new Error(j.error || 'Session expired'); } if (!r.ok) throw new Error(j.error || 'Error ' + r.status); return j; }
function busy(t) { app.innerHTML = '<div class="center"><div class="spin"></div>' + esc(t || 'Working…') + '</div>'; }
function go(tab) { if (typeof stopCam === 'function') stopCam(); ['home', 'att', 'lr', 'list'].forEach(t => $('t-' + t).classList.toggle('on', t === tab)); ({ home: renderHome, att: renderAtt, lr: renderLr, list: renderList })[tab](); window.scrollTo(0, 0); }
function save() { localStorage.setItem('ls_session', JSON.stringify(S)); }

/* ---- login: mobile + OTP ---- */
let LOGIN_MOBILE = '';
function renderLogin(msg) { $('tabs').classList.add('hide'); $('who').textContent = '';
  app.innerHTML = '<div class="card"><div class="h">Loading Supervisor<br><span class="r">Sign in</span></div>' + (msg ? '<div class="msg err">' + esc(msg) + '</div>' : '') +
    '<label>Registered mobile number</label><input id="mobile" type="tel" inputmode="numeric" maxlength="10" placeholder="10-digit mobile" value="' + esc(LOGIN_MOBILE) + '" style="font-size:22px;letter-spacing:2px" onkeydown="if(event.key===\'Enter\')sendOtp()">' +
    '<button class="btn" onclick="sendOtp()">Send OTP</button>' + (CFG.allowPin ? '<button class="btn ghost" onclick="renderPinLogin()">Sign in with code + PIN</button>' : '') +
    '<p class="muted" style="margin-top:14px">JNPTC (Container) and JNPT-E (Booking) supervisors use the same app — your division is set by HR against your mobile number.<br>Help: HR ' + esc(CFG.hrMobile) + '</p></div>'; }
async function sendOtp() { const m = $('mobile').value.replace(/\D/g, '').slice(-10); if (m.length !== 10) return renderLogin('Enter your 10-digit mobile number.'); LOGIN_MOBILE = m; busy('Sending OTP…');
  try { const r = await api('/otp/send', { mobile: m }); renderOtp(r); } catch (e) { renderLogin(e.message); } }
function renderOtp(r, msg) { app.innerHTML = '<div class="card"><div class="h">Hi ' + esc(r.name.split(' ')[0]) + '<br><span class="r">Enter OTP</span></div>' + (msg ? '<div class="msg err">' + esc(msg) + '</div>' : '<div class="msg ok">OTP sent to ' + esc(r.masked) + (r.via === 'console' ? ' — test mode, OTP: <b>' + esc(r.devOtp) + '</b>' : '') + '</div>') +
    '<label>OTP</label><input id="otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" style="font-size:26px;letter-spacing:8px;text-align:center" onkeydown="if(event.key===\'Enter\')verifyOtp()">' +
    '<button class="btn" onclick="verifyOtp()">Verify &amp; sign in</button><button class="btn ghost" onclick="renderLogin()">Change number / resend</button><p class="muted">Valid for 100 seconds (Perfios) / 5 minutes. You stay signed in on this phone for 30 days.</p></div>'; $('otp').focus(); window._otpR = r; }
async function verifyOtp() { const otp = $('otp').value.replace(/\D/g, ''); if (otp.length < 4) return; busy('Verifying…'); try { S = await api('/otp/verify', { mobile: LOGIN_MOBILE, otp }); save(); start(); } catch (e) { renderOtp(window._otpR, e.message); } }
function renderPinLogin(msg) { app.innerHTML = '<div class="card"><div class="h">Loading Supervisor<br><span class="r">Code + PIN</span></div>' + (msg ? '<div class="msg err">' + esc(msg) + '</div>' : '') +
    '<label>Employee code</label><input id="code" autocapitalize="characters" placeholder="e.g. LS001"><label>PIN</label><input id="pin" type="password" inputmode="numeric" onkeydown="if(event.key===\'Enter\')doLogin()"><button class="btn" onclick="doLogin()">Sign in</button><button class="btn ghost" onclick="renderLogin()">Back to OTP login</button></div>'; }
async function doLogin() { const code = $('code').value.trim(), pin = $('pin').value.trim(); if (!code || !pin) return; busy('Signing in…'); try { S = await api('/login', { code, pin }); save(); start(); } catch (e) { renderPinLogin(e.message); } }
function logout(msg) { localStorage.removeItem('ls_session'); S = null; renderLogin(msg); }
function divLabel() { return (S.division ? S.division + (S.divisionName ? ' · ' + S.divisionName : '') : S.branch); }
async function start() { $('tabs').classList.remove('hide'); $('who').textContent = S.name + ' · ' + (S.division || S.branch); go('home'); try { const m = await api('/me'); S.today = m.today; S.division = m.division; S.divisionName = m.divisionName; S.branch = m.branch; save(); $('who').textContent = S.name + ' · ' + (S.division || S.branch); if ($('t-home').classList.contains('on')) renderHome(); } catch (e) {} }

/* ---- home ---- */
function lrRow(r) { return '<div class="lr"><div><b>' + esc(r.cn) + '</b> · ' + esc(r.vehicle) + '<br><span class="muted">' + esc(r.consignee) + ' → ' + esc(r.to) + ' · ' + esc(r.ts) + '</span></div><div><a href="' + r.cons + '" target="_blank">Consignee</a><br><a href="' + r.drv + '" target="_blank">Driver</a>' + (r.consr ? '<br><a href="' + r.consr + '" target="_blank">Consignor</a>' : '') + '</div></div>'; }
function renderHome() { const t = S.today || {};
  app.innerHTML = '<div class="card"><div class="h">' + esc(S.name) + '<br><span class="r">' + esc(divLabel()) + '</span></div><div class="muted" style="margin-top:-4px;margin-bottom:8px">' + esc(S.branch) + '</div>' +
    '<div class="row"><div><div class="muted">Check-in</div><div class="big">' + (t.in ? esc(t.in.slice(12, 17)) : '—') + '</div></div><div><div class="muted">Check-out</div><div class="big">' + (t.out ? esc(t.out.slice(12, 17)) : '—') + '</div></div><div><div class="muted">LRs today</div><div class="big">' + (t.lrCount || 0) + '</div></div></div>' +
    (!t.in ? '<button class="btn" onclick="go(\'att\')">Check in now</button>' : '<button class="btn" onclick="go(\'lr\')">New LR from e-way bill</button>') + '</div>' +
    '<div class="card"><h3 style="margin-top:0">Recent LRs</h3>' + ((t.recent || []).map(lrRow).join('') || '<div class="muted">None yet</div>') + '</div><button class="btn ghost" onclick="logout()">Sign out</button>'; }

/* ---- attendance ---- */
let ADDR = '', STREAM = null, ATT_TYPE = '';
function stopCam() { if (STREAM) { STREAM.getTracks().forEach(t => t.stop()); STREAM = null; } }
function renderAtt() { const t = S.today || {}; photoData = ''; ADDR = ''; ATT_TYPE = !t.in ? 'IN' : 'OUT';
  app.innerHTML = '<div class="card"><div class="h">Attendance<br><span class="r">' + new Date().toLocaleDateString('en-IN', { weekday: 'long', day: '2-digit', month: 'short' }) + '</span></div>' +
    '<div class="row"><div><span class="pill ' + (t.in ? 'g' : '') + '">IN ' + (t.in ? esc(t.in.slice(12, 17)) : 'pending') + '</span></div><div><span class="pill ' + (t.out ? 'g' : '') + '">OUT ' + (t.out ? esc(t.out.slice(12, 17)) : 'pending') + '</span></div></div>' +
    '<div class="row" style="margin-top:10px"><button class="btn sm ' + (ATT_TYPE === 'IN' ? '' : 'ghost') + '" onclick="setType(\'IN\')" id="ty-IN">Check-in</button><button class="btn sm ' + (ATT_TYPE === 'OUT' ? '' : 'ghost') + '" onclick="setType(\'OUT\')" id="ty-OUT">Check-out</button></div>' +
    '<div id="geo" class="msg info" style="margin-top:12px">📡 Getting your GPS location…</div>' +
    '<h3>Selfie (stamped with time &amp; location)</h3><video id="v" autoplay playsinline muted></video><canvas id="cv" class="hide"></canvas>' +
    '<button class="btn dark" id="snap" onclick="snap()" disabled>Waiting for location…</button><button class="btn ghost hide" id="retake" onclick="retake()">Retake</button>' +
    '<label>Note (optional)</label><input id="note" placeholder="e.g. at Gate 3, yard B">' +
    '<button class="btn" id="mark" onclick="mark()" disabled>Submit check-' + ATT_TYPE.toLowerCase() + '</button></div>';
  getGeo(); startCam(); }
function setType(t) { ATT_TYPE = t; ['IN', 'OUT'].forEach(x => $('ty-' + x).className = 'btn sm' + (x === t ? '' : ' ghost')); $('mark').textContent = 'Submit check-' + t.toLowerCase(); if (photoData) retake(); }
function getGeo() { GEO = null; if (!navigator.geolocation) { $('geo').textContent = 'Location not available on this device.'; $('geo').className = 'msg err'; return; }
  navigator.geolocation.getCurrentPosition(async p => { GEO = { lat: p.coords.latitude, lng: p.coords.longitude, acc: Math.round(p.coords.accuracy) }; if (!$('geo')) return;
      $('geo').innerHTML = '📍 ' + GEO.lat.toFixed(5) + ', ' + GEO.lng.toFixed(5) + ' (±' + GEO.acc + ' m) · finding address…'; $('geo').className = 'msg ok';
      try { const g = await api('/geocode', { lat: GEO.lat, lng: GEO.lng }); ADDR = g.address || ''; } catch (e) { ADDR = ''; }
      if ($('geo')) { $('geo').innerHTML = '📍 ' + esc(ADDR || (GEO.lat.toFixed(5) + ', ' + GEO.lng.toFixed(5))) + ' <span class="muted">(±' + GEO.acc + ' m)</span>'; $('snap').disabled = false; $('snap').textContent = 'Take selfie'; } },
    e => { if ($('geo')) { $('geo').textContent = 'Location blocked: ' + e.message + '. Allow location for this site and reload — attendance needs GPS.'; $('geo').className = 'msg err'; } }, { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 }); }
async function startCam() { stopCam(); try { STREAM = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 960 } }, audio: false }); $('v').srcObject = STREAM; } catch (e) { $('snap').textContent = 'Camera blocked — allow camera access'; $('snap').disabled = true; } }
function stampLines() { const now = new Date(); const ts = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') + ' ' + now.toLocaleTimeString('en-GB', { hour12: false }) + ' IST';
  return { head: 'BEST ROADWAYS · ' + (S.division || S.branch) + ' · CHECK-' + ATT_TYPE, lines: [S.name + ' (' + S.code + ') · ' + S.branch, ts, GEO ? GEO.lat.toFixed(6) + ', ' + GEO.lng.toFixed(6) + '  ±' + GEO.acc + ' m' : 'GPS unavailable'], addr: ADDR }; }
function wrapText(ctx, text, maxW, maxLines) { const out = []; let line = ''; text.split(/\s+/).forEach(w => { const t = line ? line + ' ' + w : w; if (ctx.measureText(t).width <= maxW) line = t; else { if (line) out.push(line); line = w; } }); if (line) out.push(line); return out.slice(0, maxLines); }
function snap() { const v = $('v'), c = $('cv'); if (!v.videoWidth) return alert('Camera not ready yet.'); const W = 720, H = Math.round(W * v.videoHeight / v.videoWidth) || 960; c.width = W; c.height = H; const x = c.getContext('2d');
  x.translate(W, 0); x.scale(-1, 1); x.drawImage(v, 0, 0, W, H); x.setTransform(1, 0, 0, 1, 0, 0); // un-mirror selfie
  const st = stampLines(); x.font = '15px Arial'; const addrLines = st.addr ? wrapText(x, st.addr, W - 32, 2) : []; const lines = st.lines.concat(addrLines); const bandH = 34 + lines.length * 21 + 12;
  x.fillStyle = 'rgba(0,0,0,0.62)'; x.fillRect(0, H - bandH, W, bandH); x.fillStyle = '#c8102e'; x.fillRect(0, H - bandH, W, 4); x.fillRect(0, 0, W, 30); x.fillStyle = '#fff'; x.font = 'bold 15px Arial'; x.textBaseline = 'middle'; x.fillText(st.head, 14, 15);
  x.textBaseline = 'alphabetic'; x.font = 'bold 17px Arial'; x.fillText(lines[0], 16, H - bandH + 28); x.font = '15px Arial'; lines.slice(1).forEach((ln, i) => x.fillText(ln, 16, H - bandH + 28 + 21 * (i + 1)));
  photoData = c.toDataURL('image/jpeg', 0.8); c.classList.remove('hide'); v.classList.add('hide'); $('snap').classList.add('hide'); $('retake').classList.remove('hide'); $('mark').disabled = false; stopCam(); }
function retake() { photoData = ''; $('cv').classList.add('hide'); $('v').classList.remove('hide'); $('snap').classList.remove('hide'); $('retake').classList.add('hide'); $('mark').disabled = true; startCam(); }
async function mark() { const type = ATT_TYPE; if (!GEO) return alert('GPS location not locked yet.'); if (!photoData) return alert('Please take the selfie first.');
  $('mark').disabled = true; $('mark').textContent = 'Saving…';
  try { const r = await api('/attendance', { type, lat: GEO.lat, lng: GEO.lng, accuracy: GEO.acc, photo: photoData, address: ADDR, note: $('note').value }); S.today = r.today; save();
    app.innerHTML = '<div class="card"><div class="h">' + (type === 'IN' ? 'Checked in' : 'Checked out') + '<br><span class="r">' + esc(r.time.slice(12)) + '</span></div><img src="' + r.photo + '" style="width:100%;border-radius:3px"><p>' + esc(r.addr || 'Location saved') + '</p>' + (r.geoNote ? '<span class="pill ' + (/OFF/.test(r.geoNote) ? 'r' : 'g') + '">' + esc(r.geoNote) + '</span>' : '') + '<button class="btn" onclick="go(\'home\')">Done</button></div>'; }
  catch (e) { alert(e.message); if (S) renderAtt(); } }

/* ---- new LR ---- */
function renderLr() { app.innerHTML = '<div class="card"><div class="h">New LR<br><span class="r">Step 1 · E-way bill</span></div><label>E-way bill number <span class="req">*</span></label><input id="ewb" inputmode="numeric" maxlength="12" placeholder="12 digits" style="font-size:22px;letter-spacing:2px" onkeydown="if(event.key===\'Enter\')fetchEwb()">' +
  '<button class="btn" onclick="fetchEwb()">Fetch details</button><button class="btn ghost" onclick="renderForm({})">Skip — enter everything manually</button><div id="m"></div></div>'; }
async function fetchEwb() { const n = $('ewb').value.replace(/\D/g, ''); if (n.length !== 12) { $('m').innerHTML = '<div class="msg err">Enter the 12-digit e-way bill number.</div>'; return; } busy('Fetching e-way bill ' + n + '…');
  try { const r = await api('/ewb', { ewbNo: n }); renderForm(r.lr); } catch (e) { renderLr(); $('ewb').value = n; $('m').innerHTML = '<div class="msg err">' + esc(e.message) + '</div><button class="btn ghost" onclick="renderForm({ewbNo:\'' + n + '\'})">Continue manually with this number</button>'; } }
function f(id, label, val, o) { o = o || {}; return '<div' + (o.ewb && val ? ' class="ewb"' : '') + '><label>' + esc(label) + (o.req ? ' <span class="req">*</span>' : '') + '</label>' + (o.type === 'textarea' ? '<textarea id="' + id + '">' + esc(val || '') + '</textarea>' : o.options ? '<select id="' + id + '">' + o.options.map(x => '<option' + (x === (val || o.def) ? ' selected' : '') + '>' + esc(x) + '</option>').join('') + '</select>' : '<input id="' + id + '" value="' + esc(val || '') + '"' + (o.ph ? ' placeholder="' + esc(o.ph) + '"' : '') + (o.im ? ' inputmode="' + o.im + '"' : '') + '>') + '</div>'; }
function itemRow(it) { return '<div class="item"><input placeholder="Product" value="' + esc(it.product) + '"><input placeholder="Pkgs" inputmode="numeric" value="' + esc(it.pkgs) + '"><input placeholder="Type" value="' + esc(it.type) + '"><button class="x" onclick="this.parentNode.remove()">×</button></div>'; }
function addItem() { $('items').insertAdjacentHTML('beforeend', itemRow({ product: '', pkgs: '', type: '' })); }
async function loadCn() { try { const r = await api('/next-cn'); if ($('cnNo')) $('cnNo').value = r.cn; } catch (e) { if ($('cnNo')) $('cnNo').value = 'Auto (assigned on save)'; } }
function renderForm(E) { setTimeout(loadCn, 0); E = E || {}; const today = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-'); const items = E.items && E.items.length ? E.items : [{ product: '', pkgs: '', type: '' }]; const br = CFG.branches.length ? CFG.branches : [S.branch];
  app.innerHTML = '<div class="card"><div class="h">New LR<br><span class="r">Step 2 · Check &amp; fill</span></div>' + (E.ewbNo && E.consignorName ? '<div class="msg ok">E-way bill ' + esc(E.ewbNo) + ' fetched' + (E.ewbStatus ? ' · status ' + esc(E.ewbStatus) : '') + (E.validTill ? ' · valid till ' + esc(E.validTill) : '') + '. Pink fields came from the e-way bill — correct if needed.</div>' : '<div class="msg info">Manual entry. Fill all starred fields.</div>') +
    '<h3>Booking</h3>' + '<div><label>CN No. (auto-generated)</label><input id="cnNo" value="Loading…" readonly style="background:#f1f1f1;font-weight:700"></div>' + '<div class="row">' + f('pickupDate', 'Pickup date', today, { req: 1 }) + f('tripId', 'Trip ID', '') + '</div>' +
    f('bookingType', 'Booking type', '', { options: ['FTL', 'FTL – Import Container', 'FTL – Export Container', 'PTL', 'Trailer', 'Bulk'], def: 'FTL' }) +
    '<div class="row">' + f('loadingStation', 'Loading station', E.loadingStation, { req: 1, ewb: 1 }) + f('deliveryStation', 'Delivery station', E.deliveryStation, { req: 1, ewb: 1 }) + '</div>' +
    '<div class="row">' + f('vehicleNo', 'Vehicle no.', E.vehicleNo, { req: 1, ewb: 1 }) + f('loadType', 'Load type', '', { ph: 'e.g. 40 ft HC, 32 ft MXL' }) + '</div>' +
    '<h3>Consignor</h3>' + f('consignorName', 'Company', E.consignorName, { req: 1, ewb: 1 }) + f('consignorAddr', 'Address', E.consignorAddr, { type: 'textarea', ewb: 1 }) + f('consignorGstin', 'GSTIN', E.consignorGstin, { ewb: 1 }) +
    '<div class="row">' + f('consignorContact', 'Contact name (optional)', '', { ph: 'person to send LR copy' }) + f('consignorMobile', 'Mobile (optional)', '', { im: 'numeric', ph: '10-digit' }) + '</div>' +
    '<h3>Consignee</h3>' + f('consigneeName', 'Company', E.consigneeName, { req: 1, ewb: 1 }) + f('consigneeAddr', 'Address', E.consigneeAddr, { type: 'textarea', ewb: 1 }) + f('consigneeGstin', 'GSTIN', E.consigneeGstin, { ewb: 1 }) +
    '<h3>Said to contain</h3><div id="items">' + items.map(itemRow).join('') + '</div><button class="btn ghost sm" onclick="addItem()">+ Add line</button>' +
    '<div class="row">' + f('actualWt', 'Actual weight', '', { im: 'decimal' }) + f('chargedWt', 'Charged weight', '', { im: 'decimal' }) + f('unit', 'Unit', '', { options: ['KG', 'MT', 'Ltr', 'Nos'] }) + '</div>' +
    '<div class="row">' + f('basis', 'Basis of booking', '', { options: ['To Be Billed', 'Paid', 'To Pay'] }) + f('billingBranch', 'Billing branch', S.branch, { options: br.includes(S.branch) ? br : [S.branch].concat(br) }) + '</div>' +
    '<h3>Documents</h3><div class="row">' + f('ewbNo', 'E-way bill no.', E.ewbNo, { ewb: 1, im: 'numeric' }) + f('validTill', 'Valid till', E.validTill, { ewb: 1 }) + '</div>' +
    '<div class="row">' + f('containerNo', 'Container no.', '') + f('sealNo', 'Seal no.', '') + '</div>' + f('invoiceNo', 'Invoice / BE no.', E.invoiceNo, { ewb: 1 }) + '<div class="row">' + f('invoiceDate', 'Invoice date', E.invoiceDate, { ewb: 1 }) + f('invoiceValue', 'Invoice value (Rs)', E.invoiceValue, { ewb: 1 }) + '</div>' +
    '<h3>Delivery</h3><div class="row">' + f('deliveryType', 'Delivery type', '', { options: ['Door', 'Godown', 'Port / CFS', 'Factory'] }) + f('driverPhone', 'Driver phone', '', { req: 1, im: 'numeric' }) + '</div>' + f('remarks', 'Any other remarks', '', { type: 'textarea' }) +
    '<h3>Freight (optional — blank for To Be Billed)</h3><div class="row">' + f('freight', 'Freight', '', { im: 'decimal' }) + f('labour', 'Labour', '', { im: 'decimal' }) + f('others', 'Others', '', { im: 'decimal' }) + '</div><div class="row">' + f('cnCharges', 'CN charges', '', { im: 'decimal' }) + f('igst', 'IGST', '', { im: 'decimal' }) + f('total', 'Total', '', { im: 'decimal' }) + '</div>' +
    '<h3>Sign-off</h3>' + f('consignorSignName', 'Consignor representative name', '', { ph: 'person handing over the goods' }) +
    '<div id="m"></div><button class="btn" id="gen" onclick="generate()">Generate LR PDFs</button><button class="btn ghost" onclick="renderLr()">Back</button></div>'; }
async function generate() { const v = id => ($(id) ? $(id).value.trim() : ''); const D = {};
  ['cnNo', 'pickupDate', 'tripId', 'bookingType', 'loadingStation', 'deliveryStation', 'vehicleNo', 'loadType', 'consignorName', 'consignorAddr', 'consignorGstin', 'consigneeName', 'consigneeAddr', 'consignorContact', 'consignorMobile', 'consigneeGstin', 'actualWt', 'chargedWt', 'unit', 'basis', 'billingBranch', 'ewbNo', 'validTill', 'containerNo', 'sealNo', 'invoiceNo', 'invoiceDate', 'invoiceValue', 'deliveryType', 'driverPhone', 'remarks', 'consignorSignName'].forEach(k => D[k] = v(k));
  D.vehicleNo = D.vehicleNo.toUpperCase().replace(/\s+/g, ''); D.driverPhone = D.driverPhone.replace(/\D/g, '').slice(-10); D.consignorMobile = D.consignorMobile.replace(/\D/g, '').slice(-10);
  D.items = Array.from(document.querySelectorAll('#items .item')).map(r => { const i = r.querySelectorAll('input'); return { product: i[0].value.trim(), pkgs: i[1].value.trim(), type: i[2].value.trim() }; }).filter(i => i.product || i.pkgs);
  D.rates = {}; ['freight', 'labour', 'others', 'cnCharges', 'igst', 'total'].forEach(k => { if (v(k)) D.rates[k] = v(k); });
  const miss = [['vehicleNo', 'Vehicle no.'], ['consignorName', 'Consignor'], ['consigneeName', 'Consignee'], ['loadingStation', 'Loading station'], ['deliveryStation', 'Delivery station'], ['driverPhone', 'Driver phone']].filter(([k]) => !D[k]).map(([, n]) => n);
  if (miss.length) { $('m').innerHTML = '<div class="msg err">Missing: ' + miss.join(', ') + '</div>'; $('m').scrollIntoView(); return; }
  if (D.driverPhone.length !== 10) { $('m').innerHTML = '<div class="msg err">Driver phone must be 10 digits.</div>'; $('m').scrollIntoView(); return; }
  if (D.consignorMobile && D.consignorMobile.length !== 10) { $('m').innerHTML = '<div class="msg err">Consignor mobile must be 10 digits (or leave it blank).</div>'; $('m').scrollIntoView(); return; }
  $('gen').disabled = true; $('gen').textContent = 'Generating PDFs…';
  try { const r = await api('/lr', { lr: D }); S.today = r.today; save();
    const wa = 'https://wa.me/91' + D.driverPhone + '?text=' + encodeURIComponent('Best Roadways LR ' + r.cnNo + '\nVehicle ' + D.vehicleNo + ' | ' + D.loadingStation + ' → ' + D.deliveryStation + '\nDriver copy: ' + r.driverAbs);
    const waC = 'https://wa.me/' + (D.consignorMobile ? '91' + D.consignorMobile : '') + '?text=' + encodeURIComponent('Best Roadways LR ' + r.cnNo + (D.consignorContact ? '\nDear ' + D.consignorContact + ',' : '') + '\nVehicle ' + D.vehicleNo + ' | ' + D.loadingStation + ' → ' + D.deliveryStation + '\nConsignor copy: ' + r.consignorAbs);
    app.innerHTML = '<div class="card"><div class="h">LR generated<br><span class="r">' + esc(r.cnNo) + '</span></div><p>' + esc(D.vehicleNo) + ' · ' + esc(D.loadingStation) + ' → ' + esc(D.deliveryStation) + '</p>' +
      '<a class="btn dark" href="' + r.consigneeUrl + '" target="_blank">Open consignee copy</a><a class="btn dark" href="' + r.driverUrl + '" target="_blank">Open driver copy</a><a class="btn dark" href="' + r.consignorUrl + '" target="_blank">Open consignor copy</a><a class="btn wa" href="' + wa + '" target="_blank">WhatsApp driver copy to ' + esc(D.driverPhone) + '</a><a class="btn wa" href="' + waC + '" target="_blank">' + (D.consignorMobile ? 'WhatsApp consignor copy to ' + esc(D.consignorMobile) : 'WhatsApp consignor copy (pick contact)') + '</a>' +
      '<button class="btn ghost" onclick="go(\'lr\')">Next LR</button><button class="btn ghost" onclick="go(\'home\')">Home</button></div>'; }
  catch (e) { if (!S) return; $('gen').disabled = false; $('gen').textContent = 'Generate LR PDFs'; $('m').innerHTML = '<div class="msg err">' + esc(e.message) + '</div>'; $('m').scrollIntoView(); } }
function renderList() { const t = S.today || {}; app.innerHTML = '<div class="card"><div class="h">My LRs<br><span class="r">last 5</span></div>' + ((t.recent || []).map(lrRow).join('') || '<div class="muted">None yet</div>') + '<p class="muted" style="margin-top:12px">Full register: admin page.</p></div>'; }

(async () => { try { CFG = await api('/config'); } catch (e) {} if (S) start(); else renderLogin(); })();
