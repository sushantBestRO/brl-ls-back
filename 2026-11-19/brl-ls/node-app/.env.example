# Copy to .env and edit. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000          # public URL of this server (used in WhatsApp share links)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PIN=847213                        # admin page PIN

# Whitebooks e-way bill API (sandbox values below; replace with production)
EWB_BASE_URL=https://api.whitebooks.in/ewaybillapi/v1.03
EWB_AUTH_PATH=/authenticate
EWB_GET_PATH=/ewayapi/getewaybill
EWB_EMAIL=shishir.ambekar@bestroadways.com
EWB_USERNAME=BestRoadwa_API_bro
EWB_PASSWORD=BestRoadways$7
EWB_CLIENT_ID=EWBPfd5040e9-1078-4d18-bca4-c3b54ea410a9
EWB_CLIENT_SECRET=EWBP5ecc49ca-530d-4391-88f4-31dc8d7abfe4
EWB_GSTIN=88AAACB4214A1ZJ               # SANDBOX placeholder – production = BRL GSTIN
EWB_IP=111.111.111.111                   # SANDBOX placeholder – production = this server's static IP

# Login: mobile + OTP.  SMS_PROVIDER = console (test: OTP shown in log and on /admin) | msg91 | webhook
SMS_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=                       # DLT-approved OTP template with variable ##OTP##
SMS_URL=                                 # for webhook provider, e.g. https://sms.example.com/send?to={mobile}&msg={text}&key=XXX
SMS_METHOD=GET
SMS_TEXT=Your Best Roadways LS App OTP is {otp}. Valid for 5 minutes.
SESSION_DAYS=30                          # how long a phone stays signed in after OTP
ALLOW_PIN_LOGIN=false                    # emergency fallback: employee code + PIN

# LR numbering fallback (normally per-division prefix/serial set in /admin → System → Divisions)
CN_PREFIX=DRG/LS/
CN_START=1001

# Attendance
REQUIRE_SELFIE=true                       # selfie is stamped with name, division, time, GPS and address
GEO_RADIUS_M=0                            # 0 = accept any location; else flag OFF-SITE beyond N metres from branch lat/lng
REVERSE_GEOCODE=true                      # uses OpenStreetMap Nominatim (free, 1 req/sec)
HR_MOBILE=9594963332
